{
  "compilerOptions": {
    "strict": true,
    "sourceMap": false,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "easy-jsx-html-engine",
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node", "easy-jsx-html-engine/jsx-runtime"]
  },
  "exclude": ["node_modules", "playground", "tests/types"],
  "include": ["**/*.ts", "global.d.ts"]
}
